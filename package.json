{
  "name": "dsh-write-create-only",
  "version": "0.1.0",
  "description": "禁止 write 覆盖已存在的文件：write 只允许创建新文件，目标已存在时在工具执行前直接拒绝并提示改用 edit，全局所有会话生效，防止模型用 write 整体覆写已有内容。纯 host 端 dsh 插件。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "write",
    "edit",
    "create-only",
    "no-overwrite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-er/dsh-write-create-only.git"
  },
  "author": "betterer",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepare": "node build.mjs",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
